# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=data/monitor.db
APP_TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true
INITIAL_LOOKBACK_DAYS=30
OVERLAP_HOURS=48
REQUEST_TIMEOUT_SECONDS=15
MAX_ARTICLES_PER_FETCH=150
ADMIN_API_KEY=replace-with-a-long-random-secret

# Search providers.
# Bing News RSS is enabled by default and provides keyless direct-URL article discovery.
# Optional API providers can also be enabled alongside or instead of Bing News RSS.
BING_NEWS_RSS_ENABLED=true
NEWS_API_KEY=
GNEWS_API_KEY=
SERPER_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Legacy Google News RSS wrappers are intentionally unsupported because they
# cannot be resolved without violating robots.txt/feed usage restrictions.
GOOGLE_NEWS_RSS_ENABLED=false

# Google Sheets. Share the sheet with the service account email.
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEET_ID=11KZA69WxbxLeDP0O_Fg94CnooIWpzVnvJyatRuSP0rw
# Leave blank to use the first worksheet (gid=0).
GOOGLE_WORKSHEET_NAME=
# Accepts raw JSON or base64-encoded service-account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Email delivery (Resend HTTPS API recommended, or traditional SMTP fallback)
EMAIL_ENABLED=true
EMAIL_ON_MANUAL_FETCH=false
EMAIL_RECIPIENTS=

# Resend API (recommended: fast, zero port blocking, https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Green Portfolio Media Monitor <onboarding@resend.dev>

# Traditional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
